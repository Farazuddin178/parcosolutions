# WordPress install that acts as the CMS (no trailing slash).
# Read at build time for blog posts. If you move WordPress to a subdomain
# (recommended, e.g. https://cms.parcosolutions.in), update both values.
WP_URL=https://parcosolutions.in

# Same WordPress URL, exposed to the browser for the contact form.
NEXT_PUBLIC_WP_URL=https://parcosolutions.in

# Contact Form 7 form ID (WP Admin > Contact > Contact Forms).
NEXT_PUBLIC_CF7_FORM_ID=1253
